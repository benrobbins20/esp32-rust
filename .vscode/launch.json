{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "ESP32-C3 Debug",
            "chip": "ESP32-C3",
            "probe": "esp-builtin", // Use the built-in USB-JTAG debugger
            "connectUnderReset": false,
            "speed": 4000, // in kHz
            "program_binary": "${workspaceFolder}/target/riscv32imc-unknown-none-elf/debug/encoder",
            "cwd": "${workspaceFolder}",
            "rttEnabled": true, // Enable RTT for logging if you use it
            "consoleLogLevel": "Info"
        }
    ]
}